# ==============================================================================
# HACKPACT / SAATHI - ENVIRONMENT CONFIGURATION
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real keys.
# ==============================================================================

# Application URL
# Must match the port the dev server runs on (see Quickstart).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE (Postgres DB, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
# Project Settings -> API
#   Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#   anon / publishable   -> NEXT_PUBLIC_SUPABASE_ANON_KEY  (safe for the browser)
#   service_role         -> SUPABASE_SERVICE_ROLE_KEY      (SERVER ONLY)
#
# The service role key bypasses RLS. It is only read by
# src/lib/supabase/admin.ts, which is imported exclusively by server
# route handlers. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# UPSTASH REDIS (Rate Limiting, Matching Cache, Background Queues)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# ------------------------------------------------------------------------------
# RESEND (Transactional Emails)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="Hackpact <noreply@hackpact.dev>"

# ------------------------------------------------------------------------------
# WEB PUSH (VAPID Keys for Notifications)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BK...your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:support@hackpact.dev"

# ------------------------------------------------------------------------------
# GITHUB API (Profile Verification & Repository language stats)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_PAT="optional_personal_access_token_for_higher_rate_limit"
GITHUB_TOKEN="your_github_token_for_api_calls_same_as_PAT_or_fine_grained"


# ------------------------------------------------------------------------------
# OBSERVABILITY & ANALYTICS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
SENTRY_DSN="https://your_sentry_dsn@sentry.io/1234567"
NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_dsn@sentry.io/1234567"

# ------------------------------------------------------------------------------
# CRON & INTERNAL SECRETS
# ------------------------------------------------------------------------------
CRON_SECRET="your_secure_random_string_for_cron_and_internal_jobs"
ADMIN_BOOTSTRAP_TOKEN="admin_secret_token_to_claim_initial_superadmin"
